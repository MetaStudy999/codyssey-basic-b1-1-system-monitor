# B1-1 Agent 환경변수 예시
# 실제 비밀값은 이 파일에 기록하지 않습니다.

AGENT_HOME=/home/agent-admin/agent-app
AGENT_PORT=15034
AGENT_UPLOAD_DIR=/home/agent-admin/agent-app/upload_files
AGENT_KEY_PATH=/home/agent-admin/agent-app/api_keys/t_secret.key
AGENT_LOG_DIR=/var/log/agent-app

# 제공 Agent 실행 파일명을 기준으로 monitor.sh가 프로세스를 찾습니다.
# x86_64: agent-app-linux-x86
# arm64:  agent-app-linux-arm64
# Python 형태의 제공 앱이면 agent_app.py로 변경할 수 있습니다.
AGENT_PROCESS_PATTERN=agent-app-linux-x86
