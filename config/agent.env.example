# B1-1 Agent environment example
# 실제 비밀값은 이 파일에 기록하지 않습니다.
# 원본 미션의 AGENT_HOME 예시를 이 안내서 표준 경로로 사용합니다.

AGENT_HOME=/home/agent-admin/agent-app
AGENT_PORT=15034
AGENT_UPLOAD_DIR=/home/agent-admin/agent-app/upload_files
AGENT_KEY_PATH=/home/agent-admin/agent-app/api_keys/t_secret.key
AGENT_LOG_DIR=/var/log/agent-app

# monitor.sh 전용 선택 설정입니다. 제공 Agent 자체의 필수 환경변수가 아닙니다.
# `uname -m`과 `unzip -l agent-app.zip`으로 실제 제공 파일을 확인한 뒤 설정합니다.
# x86_64 예: AGENT_PROCESS_PATTERN=agent-app-linux-x86
# arm64 예:  AGENT_PROCESS_PATTERN=agent-app-linux-arm64
