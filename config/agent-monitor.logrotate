# B1-1 monitor.log rotation policy
# Install as /etc/logrotate.d/agent-monitor
# Strict interpretation of "10MB / maximum 10 files":
# current monitor.log + up to 9 rotated files = at most 10 files total.

/var/log/agent-app/monitor.log {
    size 10M
    rotate 9
    compress
    missingok
    notifempty
    su agent-admin agent-core
    create 0660 agent-admin agent-core
}
