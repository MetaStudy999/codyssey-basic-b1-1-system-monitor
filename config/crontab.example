# B1-1 agent-admin crontab
# Install with: sudo -u agent-admin crontab < config/crontab.example

SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
MAILTO=""

# Run monitor.sh every minute.
# monitor.sh loads /etc/agent-app/agent.env itself so it does not depend on an interactive login shell.
* * * * * /home/agent-admin/agent-app/bin/monitor.sh >/dev/null 2>&1
